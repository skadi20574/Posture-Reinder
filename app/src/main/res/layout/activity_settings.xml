<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/plate"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置"
            android:textColor="@color/fg"
            android:textSize="22sp"
            android:letterSpacing="0.06" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="SETTINGS"
            android:textColor="@color/fg3"
            android:textSize="10sp"
            android:letterSpacing="0.2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/tabRemind"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:backgroundTint="@color/panel"
                android:text="提醒"
                android:textColor="@color/accent"
                android:textSize="12sp" />
            <Button
                android:id="@+id/tabMonitor"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/panel"
                android:text="监控"
                android:textColor="@color/fg3"
                android:textSize="12sp" />
            <Button
                android:id="@+id/tabFocus"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/panel"
                android:text="专注"
                android:textColor="@color/fg3"
                android:textSize="12sp" />
            <Button
                android:id="@+id/tabUi"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/panel"
                android:text="界面"
                android:textColor="@color/fg3"
                android:textSize="12sp" />
            <Button
                android:id="@+id/tabData"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/panel"
                android:text="数据"
                android:textColor="@color/fg3"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="@color/line" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ============================================== 提醒 -->
        <ScrollView
            android:id="@+id/pageRemind"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="坐姿不对持续多久才提醒"
                        android:textColor="@color/fg2"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/tvDwell"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6 秒"
                        android:textColor="@color/accent"
                        android:textSize="13sp" />
                </LinearLayout>
                <SeekBar
                    android:id="@+id/sbDwell"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="28" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="重复提醒间隔"
                        android:textColor="@color/fg2"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/tvCooldown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="120 秒"
                        android:textColor="@color/accent"
                        android:textSize="13sp" />
                </LinearLayout>
                <SeekBar
                    android:id="@+id/sbCooldown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="59" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="一次不良最多提醒几次（最右为无限）"
                        android:textColor="@color/fg2"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/tvRepeat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 次"
                        android:textColor="@color/accent"
                        android:textSize="13sp" />
                </LinearLayout>
                <SeekBar
                    android:id="@+id/sbRepeat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="20" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="语音提醒"
                        android:textColor="@color/fg2"
                        android:textSize="13sp" />
                    <Switch
                        android:id="@+id/swVoice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="提示：重复间隔设 5 秒就会一直催；后仰只记录不提醒。"
                    android:textColor="@color/fg3"
                    android:textSize="11sp" />
            </LinearLayout>
        </ScrollView>

        <!-- ============================================== 监控 -->
        <ScrollView
            android:id="@+id/pageMonitor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="监控频率"
                        android:textColor="@color/fg2"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/tvFps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3.6 帧/秒"
                        android:textColor="@color/accent"
                        android:textSize="13sp" />
                </LinearLayout>
                <SeekBar
                    android:id="@+id/sbFps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="7" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="坐姿灵敏度"
                    android:textColor="@color/fg2"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/sensStrict"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/panel"
                        android:text="严格"
                        android:textColor="@color/fg3"
                        android:textSize="12sp" />
                    <Button
                        android:id="@+id/sensNormal"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/panel"
                        android:text="标准"
                        android:textColor="@color/fg3"
                        android:textSize="12sp" />
                    <Button
                        android:id="@+id/sensLoose"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/panel"
                        android:text="宽松"
                        android:textColor="@color/fg3"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="注视识别（判断是否专注）"
                        android:textColor="@color/fg2"
                        android:textSize="13sp" />
                    <Switch
                        android:id="@+id/swAttention"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="频率越高越跟手，也越费电；注视识别关闭后不再判断专注和分心。"
                    android:textColor="@color/fg3"
                    android:textSize="11sp" />
            </LinearLayout>
        </ScrollView>

        <!-- ============================================== 专注 -->
        <ScrollView
            android:id="@+id/pageFocus"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="连续专注多久提醒休息"
                        android:textColor="@color/fg2"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/tvFocus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="40 分钟"
                        android:textColor="@color/accent"
                        android:textSize="13sp" />
                </LinearLayout>
                <SeekBar
                    android:id="@+id/sbFocus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="110" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="闭眼判定阈值"
                        android:textColor="@color/fg2"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/tvBlink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="65%"
                        android:textColor="@color/accent"
                        android:textSize="13sp" />
                </LinearLayout>
                <SeekBar
                    android:id="@+id/sbBlink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="60" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="分心判定灵敏度"
                    android:textColor="@color/fg2"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/attStrict"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/panel"
                        android:text="严格"
                        android:textColor="@color/fg3"
                        android:textSize="12sp" />
                    <Button
                        android:id="@+id/attNormal"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/panel"
                        android:text="标准"
                        android:textColor="@color/fg3"
                        android:textSize="12sp" />
                    <Button
                        android:id="@+id/attLoose"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/panel"
                        android:text="宽松"
                        android:textColor="@color/fg3"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="闭眼阈值越低越容易判定为闭眼；分心灵敏度「严格」更容易认定走神。"
                    android:textColor="@color/fg3"
                    android:textSize="11sp" />
            </LinearLayout>
        </ScrollView>

        <!-- ============================================== 界面 -->
        <ScrollView
            android:id="@+id/pageUi"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="界面主题"
                    android:textColor="@color/fg2"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/themeMinimal"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/panel"
                        android:text="极简"
                        android:textColor="@color/fg3"
                        android:textSize="12sp" />
                    <Button
                        android:id="@+id/themeElegant"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/panel"
                        android:text="优雅（微光）"
                        android:textColor="@color/fg3"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnDebugPreview"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="@color/panel"
                    android:text="调试预览（画面 + 识别框）"
                    android:textColor="@color/accent"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="优雅主题会在主界面加一层缓慢流动的柔光，几乎不耗电。"
                    android:textColor="@color/fg3"
                    android:textSize="11sp" />
            </LinearLayout>
        </ScrollView>

        <!-- ============================================== 数据 -->
        <ScrollView
            android:id="@+id/pageData"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <Button
                    android:id="@+id/btnStatsPage"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:backgroundTint="@color/panel"
                    android:text="统计与打分（含导出 / 导入）"
                    android:textColor="@color/accent"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnInstallApk"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/panel"
                    android:text="选择安装包更新"
                    android:textColor="@color/accent"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnDefault"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/panel"
                    android:text="恢复默认设置"
                    android:textColor="@color/fg2"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/dataInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:textColor="@color/fg3"
                    android:textSize="11sp"
                    android:lineSpacingExtra="3dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="统计导出的 JSON 可以换机导入；安装包更新需要把 APK 先下载到手机，再在这里选择。"
                    android:textColor="@color/fg3"
                    android:textSize="11sp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
